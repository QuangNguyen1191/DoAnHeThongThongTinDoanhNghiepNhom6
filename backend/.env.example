# Mẫu biến môi trường (dùng khi triển khai thay cho User Secrets). KHÔNG commit tệp .env thật.
# Dấu "__" thay cho ":" trong tên khóa cấu hình.
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__CrmAdmin=Server=localhost\SQLEXPRESS;Database=CRM_Uniqlo;User ID=crm_app_admin;Password=<mat-khau-login-admin>;Encrypt=True;TrustServerCertificate=True;Application Name=CrmUniqlo.Api
ConnectionStrings__CrmQuanLy=Server=localhost\SQLEXPRESS;Database=CRM_Uniqlo;User ID=crm_app_quanly;Password=<mat-khau-login-quanly>;Encrypt=True;TrustServerCertificate=True;Application Name=CrmUniqlo.Api
ConnectionStrings__CrmKhachHang=Server=localhost\SQLEXPRESS;Database=CRM_Uniqlo;User ID=crm_app_khachhang;Password=<mat-khau-login-khachhang>;Encrypt=True;TrustServerCertificate=True;Application Name=CrmUniqlo.Api
Security__CookieSecureAlways=true
# Email quên mật khẩu (SMTP). Để trống SmtpHost thì API không gửi thư (chỉ ghi log cảnh báo).
Email__SmtpHost=smtp.example.com
Email__SmtpPort=587
Email__SmtpUser=<tai-khoan-smtp>
Email__SmtpPassword=<mat-khau-smtp>
Email__From=no-reply@example.com
Email__ResetUrlCrm=https://crm.example.com/dat-lai-mat-khau#token={token}
Email__ResetUrlAdmin=https://admin.example.com/dat-lai-mat-khau#token={token}
