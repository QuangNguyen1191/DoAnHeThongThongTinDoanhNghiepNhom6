{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5000;http://localhost:5001",
  "ConnectionStrings": {
    "CrmAdmin": "",
    "CrmQuanLy": "",
    "CrmKhachHang": ""
  },
  "Database": {
    "TimeZoneOffset": "07:00:00",
    "CommandTimeoutSeconds": 30
  },
  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpEnableSsl": true,
    "SmtpUser": "",
    "From": "no-reply@crm-uniqlo.local",
    "FromName": "CRM Uniqlo",
    "ResetUrlCrm": "http://localhost:5000/dat-lai-mat-khau#token={token}",
    "ResetUrlAdmin": "http://localhost:5001/dat-lai-mat-khau#token={token}",
    "ResetTokenMinutes": 30
  },
  "Security": {
    "CrmPort": 5000,
    "AdminPort": 5001,
    "SeparatePortalsByPort": true,
    "SlidingExpirationMinutes": 30,
    "MaxSessionHours": 8,
    "LoginMaxFailuresPerUser": 5,
    "LoginMaxAttemptsPerIp": 30,
    "CookieSecureAlways": true,
    "AllowedOrigins": []
  }
}
